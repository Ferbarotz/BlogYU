# Plantilla de variables de entorno. Copia a .env (dev) o configúralas en Railway/Render (prod).

# --- General ---
# En producción: production. Activa el modo prod (secrets obligatorios, sin create_all).
FLASK_ENV=production
FLASK_APP=src.api:create_app

# --- Base de datos ---
# Dev: SQLite por defecto. Prod: URI de PostgreSQL que da la plataforma.
DATABASE_URL=postgresql://usuario:password@host:5432/dbname

# --- Secretos (OBLIGATORIOS en prod) ---
SECRET_KEY=cambia-esto-por-un-valor-largo-aleatorio
JWT_SECRET_KEY=cambia-esto-por-otro-valor-largo-aleatorio

# --- Esquema DB ---
# false en prod: Alembic (flask db upgrade) es la fuente de verdad.
AUTO_CREATE_DB=false

# --- Frontend / CORS ---
# URL pública del frontend (usada en emails y para restringir CORS en prod).
FRONTEND_URL=https://tu-dominio.com
# Opcional: lista de orígenes permitidos separados por comas (anula FRONTEND_URL para CORS).
# CORS_ORIGINS=https://tu-dominio.com,https://www.tu-dominio.com

# --- Imágenes ---
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# --- Correo (reset password, opcional) ---
MAIL_SERVER=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=apikey
MAIL_PASSWORD=tu-sendgrid-api-key
MAIL_DEFAULT_SENDER=no-reply@tu-dominio.com
