const path = require('path');
const HtmlWebpackPlugin = require('html-webpack-plugin');

module.exports = {
  entry: './src/index.js',
  output: {
    path: path.resolve(__dirname, 'dist'),
    filename: 'bundle.js',
    publicPath: '/'
  },
  module: {
    rules: [
      {
        test: /\.(js|jsx)$/,
        exclude: /node_modules/,
        use: {
          loader: 'babel-loader'
        }
      },
      {
        test: /\.css$/,
        use: ['style-loader', 'css-loader']
      }
    ]
  },
  resolve: {
    extensions: ['.js', '.jsx']
  },
  plugins: [
    new HtmlWebpackPlugin({
      template: './public/index.html'
    })
  ],
 devServer: {
  static: {
    directory: path.join(__dirname, 'public'),
  },
  compress: true,
  port: 8080,
  historyApiFallback: true,
  allowedHosts: 'all', // Permite conexiones desde cualquier host (Codespaces)
  client: {
    webSocketURL: 'auto://0.0.0.0:0/ws', // Detecta automáticamente la URL correcta para Codespaces
  },
},
};
